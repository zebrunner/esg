FROM golang:1.18-alpine

RUN apk add -U ca-certificates tzdata mailcap curl git && rm -Rf /var/cache/apk/*

# Install migrate tool
RUN curl -L https://github.com/golang-migrate/migrate/releases/download/v4.14.1/migrate.linux-amd64.tar.gz | tar -xvz
RUN cp migrate.linux-amd64 /usr/bin/migrate
RUN echo $PATH

WORKDIR /esg

# Download dependencies
COPY ./go.mod .
COPY ./go.sum .
RUN go mod download

# Build esg
COPY . /esg

RUN GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build ./cmd/server


FROM alpine:latest

ENV LISTEN_PORT=4444
ENV EXCLUDE_BROWSER=

#Common for router and scaler
ENV AWS_REGION=
ENV AWS_RETRY=

ENV AWS_CLUSTER=
ENV USE_PUBLIC_IP=

ENV AWS_ACESS_KEY_ID=
ENV AWS_SECRET_ACCESS_KEY=

ENV AWS_ELASTIC_CACHE=
ENV LOG_LEVEL=
ENV S3_BUCKET=
ENV S3_REGION=
ENV S3_AWS_ACESS_KEY_ID=
ENV S3_AWS_SECRET_ACCESS_KEY=

ENV DATABASE=

ENV MAX_MEMORY=

ENV MAX_CPU=

#time.Duration format: 1m0s
ENV IDLE_TIMEOUT=
ENV SESSION_DELETE_TIMEOUT=
ENV SERVICE_STARTUP_TIMEOUT=
ENV MAX_TIMEOUT=


ENV ZEBRUNNER_HOST=
ENV ZEBRUNNER_INTEGRATION_USER=
ENV ZEBRUNNER_INTEGRATION_PASSWORD=

RUN apk add -U git tzdata
COPY ./.git /
COPY ./migrations/ /migrations/

COPY --from=0 /esg/server /server
COPY --from=0 /usr/bin/migrate /usr/bin/migrate

COPY ./build/entrypoint.router /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
