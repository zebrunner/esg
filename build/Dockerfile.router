FROM golang:1.18-alpine

RUN apk add -U tzdata && rm -Rf /var/cache/apk/*

WORKDIR /esg

# create file, that contains build tag
COPY ./build/.env version
RUN . version && echo "VERSION=$ROUTER_VERSION" > version

# Download dependencies
COPY ./go.mod .
COPY ./go.sum .
RUN go mod download

# Build esg
COPY . /esg

RUN GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build ./cmd/router


FROM alpine:latest

ENV LISTEN_PORT=4444

ENV AWS_LINUX_CAPACITY_PROVIDER=
ENV AWS_WIN_CAPACITY_PROVIDER=
ENV AWS_TARGET_GROUP=

#Common for router and scaler
ENV AWS_REGION=
ENV AWS_RETRY=
ENV AWS_TASK_ROLE=

ENV AWS_CLUSTER=
ENV USE_PUBLIC_IP=

ENV AWS_ACESS_KEY_ID=
ENV AWS_SECRET_ACCESS_KEY=

ENV AWS_ELASTIC_CACHE=
ENV LOG_LEVEL=

ENV S3_BUCKET=
ENV S3_REGION=
ENV S3_AWS_ACESS_KEY_ID=
ENV S3_AWS_SECRET_ACCESS_KEY=

ENV DATABASE=

#time.Duration format: 1m0s
ENV MAX_IDLE_TIMEOUT=
ENV IDLE_TIMEOUT=
ENV SESSION_DELETE_TIMEOUT=
ENV SERVICE_STARTUP_TIMEOUT=
ENV MAX_TIMEOUT=


ENV ZEBRUNNER_HOST=
ENV ZEBRUNNER_INTEGRATION_USER=
ENV ZEBRUNNER_INTEGRATION_PASSWORD=

ENV EXCLUDE_BROWSERS=

ENV PRODUCTION_ENV=

ENV EXTERNAL_PORT=

RUN apk add -U tzdata

COPY --from=0 /esg/version /version

COPY --from=0 /esg/router /router

COPY ./build/entrypoint.router /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
