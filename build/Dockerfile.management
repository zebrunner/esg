FROM golang:1.18-alpine

RUN apk add -U ca-certificates tzdata mailcap curl git && rm -Rf /var/cache/apk/*

WORKDIR /esg

# Download dependencies
COPY ./go.mod .
COPY ./go.sum .
RUN go mod download

# Build esg
COPY . /esg

RUN GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build ./cmd/management


FROM alpine:latest
COPY --from=0 /esg/management /management
COPY --from=0 /esg/scripts/ /scripts/
COPY --from=0 /esg/browsers.txt /browsers.txt
