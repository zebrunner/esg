#!/bin/sh

export VERSION=2.8

finish() {
  ppid=$1
  if [ -n "$ppid" ]; then
    kill -s TERM $ppid
  fi

  # wait until $ppid finished normally to provide more time for termination process
  while [ true ]; do
    ps -ef | grep $ppid | grep -v grep > /dev/null 2>&1
    if [ $? -eq 1 ]; then
      echo "process finished"
      break
    fi
    sleep 2
  done
  return 0
}

CMD_ARGS=
#scaler cli args:
if [ ! -z ${RESERVE_INSTANCES_PERCENT} ]; then
  CMD_ARGS="${CMD_ARGS} -reserve-instances-percent ${RESERVE_INSTANCES_PERCENT}"
fi
if [ ! -z ${RESERVE_MAX_CAPACITY} ]; then
  CMD_ARGS="${CMD_ARGS} -reserve-max-capacity ${RESERVE_MAX_CAPACITY}"
fi

if [ ! -z ${INSTANCE_COOLDOWN_TIMEOUT} ]; then
  CMD_ARGS="${CMD_ARGS} -instance-cooldown-timeout ${INSTANCE_COOLDOWN_TIMEOUT}"
fi

# common cli args:
if [ ! -z ${AWS_REGION} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-region ${AWS_REGION}"
fi
if [ ! -z ${AWS_RETRY} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-retry ${AWS_RETRY}"
fi
if [ ! -z ${AWS_CLUSTER} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-cluster ${AWS_CLUSTER}"
fi
if [ ! -z ${AWS_ACESS_KEY_ID} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-access-key-id ${AWS_ACESS_KEY_ID}"
fi
if [ ! -z ${AWS_SECRET_ACCESS_KEY} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-secret-access-key ${AWS_SECRET_ACCESS_KEY}"
fi
if [ ! -z ${AWS_TASK_ROLE} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-task-role-arn ${AWS_TASK_ROLE}"
fi
if [ ! -z ${AWS_ELASTIC_CACHE} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-elastic-cache ${AWS_ELASTIC_CACHE}"
fi
if [ ! -z ${LOG_LEVEL} ]; then
  CMD_ARGS="${CMD_ARGS} -log-level ${LOG_LEVEL}"
fi
if [ ! -z ${DATABASE} ]; then
  CMD_ARGS="${CMD_ARGS} -db-connection ${DATABASE}"
fi
if [ ! -z ${MAX_MEMORY} ]; then
  CMD_ARGS="${CMD_ARGS} -max-memory ${MAX_MEMORY}"
fi
if [ ! -z ${MAX_CPU} ]; then
  CMD_ARGS="${CMD_ARGS} -max-cpu ${MAX_CPU}"
fi
if [ ! -z ${MAX_IDLE_TIMEOUT} ]; then
  CMD_ARGS="${CMD_ARGS} -max-idle-timeout ${MAX_IDLE_TIMEOUT}"
fi
if [ ! -z ${IDLE_TIMEOUT} ]; then
  CMD_ARGS="${CMD_ARGS} -idle-timeout ${IDLE_TIMEOUT}"
fi
if [ ! -z ${MAX_TIMEOUT} ]; then
  CMD_ARGS="${CMD_ARGS} -max-timeout ${MAX_TIMEOUT}"
fi
if [ ! -z ${ZEBRUNNER_HOST} ]; then
  CMD_ARGS="${CMD_ARGS} -zebrunner-host ${ZEBRUNNER_HOST}"
fi
if [ ! -z ${ZEBRUNNER_INTEGRATION_USER} ]; then
  CMD_ARGS="${CMD_ARGS} -zebrunner-integration-user ${ZEBRUNNER_INTEGRATION_USER}"
fi
if [ ! -z ${ZEBRUNNER_INTEGRATION_PASSWORD} ]; then
  CMD_ARGS="${CMD_ARGS} -zebrunner-integration-password ${ZEBRUNNER_INTEGRATION_PASSWORD}"
fi
if [ ! -z ${EXCLUDE_BROWSERS} ]; then
  CMD_ARGS="${CMD_ARGS} -exclude-browsers ${EXCLUDE_BROWSERS}"
fi
if [ ! -z ${SINGLE_TENANT} ]; then
  CMD_ARGS="${CMD_ARGS} -single-tenant=${SINGLE_TENANT}"
fi

echo "CMD_ARGS: $CMD_ARGS"

./scaler $CMD_ARGS &
PID=$!

trap 'finish $PID' TERM INT

wait $PID
