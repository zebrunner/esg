#!/bin/sh

. version
export VERSION=$E3S_VERSION
export BUILD_TIME=$(date -Iseconds)

finish() {
  ppid=$1
  if [ -n "$ppid" ]; then
    kill -s TERM $ppid
  fi

  # wait until $ppid finished normally to provide more time for termination process
  while [ true ]; do
    ps -ef | grep $ppid | grep -v grep > /dev/null 2>&1
    if [ $? -eq 1 ]; then
      echo "process finished"
      break
    fi
    sleep 2
  done
  return 0
}

CMD_ARGS=
if [ ! -z ${LOG_LEVEL} ]; then
  CMD_ARGS="${CMD_ARGS} -log-level ${LOG_LEVEL}"
fi
if [ ! -z ${AWS_LOGS_GROUP} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-logs-group ${AWS_LOGS_GROUP}"
fi

if [ ! -z ${AWS_REGION} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-region ${AWS_REGION}"
fi
if [ ! -z ${AWS_RETRY} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-retry ${AWS_RETRY}"
fi
if [ ! -z ${AWS_CLUSTER} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-cluster ${AWS_CLUSTER}"
fi
if [ ! -z ${AWS_ACCESS_KEY_ID} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-access-key-id ${AWS_ACCESS_KEY_ID}"
fi
if [ ! -z ${AWS_SECRET_ACCESS_KEY} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-secret-access-key ${AWS_SECRET_ACCESS_KEY}"
fi
if [ ! -z ${AWS_TARGET_ID} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-target-id ${AWS_TARGET_ID}"
fi

if [ ! -z ${AWS_LINUX_CAPACITY_PROVIDER} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-linux-capacity-provider ${AWS_LINUX_CAPACITY_PROVIDER}"
fi
if [ ! -z ${AWS_LINUX_GENERIC_CAPACITY_PROVIDER} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-linux-generic-capacity-provider ${AWS_LINUX_GENERIC_CAPACITY_PROVIDER}"
fi
if [ ! -z ${AWS_WIN_CAPACITY_PROVIDER} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-win-capacity-provider ${AWS_WIN_CAPACITY_PROVIDER}"
fi
if [ ! -z ${AWS_TARGET_GROUP} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-target-group ${AWS_TARGET_GROUP}"
fi
if [ ! -z ${E3S_URL} ]; then
  CMD_ARGS="${CMD_ARGS} -e3s-url ${E3S_URL}"
fi
if [ ! -z ${AWS_TASK_ROLE} ]; then
  CMD_ARGS="${CMD_ARGS} -aws-task-role-arn ${AWS_TASK_ROLE}"
fi
if [ ! -z ${USE_PUBLIC_IP} ]; then
  CMD_ARGS="${CMD_ARGS} -use-public-ip=${USE_PUBLIC_IP}"
fi

if [ ! -z ${ELASTIC_CACHE} ]; then
  CMD_ARGS="${CMD_ARGS} -elastic-cache ${ELASTIC_CACHE}"
fi
if [ ! -z ${CACHE_REMOTE} ]; then
  CMD_ARGS="${CMD_ARGS} -cache-remote=${CACHE_REMOTE}"
fi
if [ ! -z ${DATABASE} ]; then
  CMD_ARGS="${CMD_ARGS} -db-connection ${DATABASE}"
fi
if [ ! -z ${DEFINITIONS_CONNECTION} ]; then
  CMD_ARGS="${CMD_ARGS} -definitions-connection ${DEFINITIONS_CONNECTION}"
fi

if [ ! -z ${S3_BUCKET} ]; then
  CMD_ARGS="${CMD_ARGS} -s3-bucket ${S3_BUCKET}"
fi
if [ ! -z ${S3_REGION} ]; then
  CMD_ARGS="${CMD_ARGS} -s3-region ${S3_REGION}"
fi
if [ ! -z ${S3_AWS_ACCESS_KEY_ID} ]; then
  CMD_ARGS="${CMD_ARGS} -s3-aws-access-key-id ${S3_AWS_ACCESS_KEY_ID}"
fi
if [ ! -z ${S3_AWS_SECRET_ACCESS_KEY} ]; then
  CMD_ARGS="${CMD_ARGS} -s3-aws-secret-access-key ${S3_AWS_SECRET_ACCESS_KEY}"
fi

if [ ! -z ${MAX_IDLE_TIMEOUT} ]; then
  CMD_ARGS="${CMD_ARGS} -max-idle-timeout ${MAX_IDLE_TIMEOUT}"
fi
if [ ! -z ${IDLE_TIMEOUT} ]; then
  CMD_ARGS="${CMD_ARGS} -idle-timeout ${IDLE_TIMEOUT}"
fi
if [ ! -z ${SESSION_DELETE_TIMEOUT} ]; then
  CMD_ARGS="${CMD_ARGS} -session-delete-timeout ${SESSION_DELETE_TIMEOUT}"
fi
if [ ! -z ${SERVICE_STARTUP_TIMEOUT} ]; then
  CMD_ARGS="${CMD_ARGS} -service-startup-timeout ${SERVICE_STARTUP_TIMEOUT}"
fi
if [ ! -z ${MAX_TIMEOUT} ]; then
  CMD_ARGS="${CMD_ARGS} -max-timeout ${MAX_TIMEOUT}"
fi

if [ ! -z ${ZEBRUNNER_HOST} ]; then
  CMD_ARGS="${CMD_ARGS} -zebrunner-host ${ZEBRUNNER_HOST}"
fi
if [ ! -z ${ZEBRUNNER_INTEGRATION_USER} ]; then
  CMD_ARGS="${CMD_ARGS} -zebrunner-integration-user ${ZEBRUNNER_INTEGRATION_USER}"
fi
if [ ! -z ${ZEBRUNNER_INTEGRATION_PASSWORD} ]; then
  CMD_ARGS="${CMD_ARGS} -zebrunner-integration-password ${ZEBRUNNER_INTEGRATION_PASSWORD}"
fi

if [ ! -z ${ECS_TASK_TAGS} ]; then
  CMD_ARGS="${CMD_ARGS} -ecs-task-tags=${ECS_TASK_TAGS}"
fi
if [ ! -z ${ECS_TASK_DEFINITION_TAGS} ]; then
  CMD_ARGS="${CMD_ARGS} -ecs-task-definition-tags=${ECS_TASK_DEFINITION_TAGS}"
fi

if [ ! -z ${UPLOADER_IMAGE} ]; then
  CMD_ARGS="${CMD_ARGS} -uploader-image ${UPLOADER_IMAGE}"
fi
if [ ! -z ${MITM_IMAGE} ]; then
  CMD_ARGS="${CMD_ARGS} -mitm-image ${MITM_IMAGE}"
fi
if [ ! -z ${RECORDER_IMAGE} ]; then
  CMD_ARGS="${CMD_ARGS} -recorder-image ${RECORDER_IMAGE}"
fi
if [ ! -z ${CYPRESS_RECORDER_IMAGE} ]; then
  CMD_ARGS="${CMD_ARGS} -cypress-recorder-image ${CYPRESS_RECORDER_IMAGE}"
fi
if [ ! -z ${CLONE_IMAGE} ]; then
  CMD_ARGS="${CMD_ARGS} -clone-image ${CLONE_IMAGE}"
fi
if [ ! -z ${ENTRYPOINT_IMAGE} ]; then
  CMD_ARGS="${CMD_ARGS} -entrypoint-image ${ENTRYPOINT_IMAGE}"
fi
if [ ! -z ${MAVEN_IMAGE} ]; then
  CMD_ARGS="${CMD_ARGS} -maven-image ${MAVEN_IMAGE}"
fi
if [ ! -z ${WIN_UPLOADER_IMAGE} ]; then
  CMD_ARGS="${CMD_ARGS} -win-uploader-image ${WIN_UPLOADER_IMAGE}"
fi
if [ ! -z ${WIN_RECORDER_IMAGE} ]; then
  CMD_ARGS="${CMD_ARGS} -win-recorder-image ${WIN_RECORDER_IMAGE}"
fi
if [ ! -z ${GENERIC_EXECUTOR_IMAGE_PROFILES} ]; then
  CMD_ARGS="${CMD_ARGS} -generic-executor-image-profiles ${GENERIC_EXECUTOR_IMAGE_PROFILES}"
fi

if [ ! -z ${PRODUCTION_ENV} ]; then
  CMD_ARGS="${CMD_ARGS} -production-env=${PRODUCTION_ENV}"
fi
if [ ! -z ${EXTERNAL_PORT} ]; then
  CMD_ARGS="${CMD_ARGS} -external-port ${EXTERNAL_PORT}"
fi
if [ ! -z ${SINGLE_TENANT} ]; then
  CMD_ARGS="${CMD_ARGS} -single-tenant=${SINGLE_TENANT}"
fi
if [ ! -z ${OLD_ABORT_API} ]; then
  CMD_ARGS="${CMD_ARGS} -old-abort-api=${OLD_ABORT_API}"
fi

if [ ! -z ${ROOT_CA_CERT} ]; then
  CMD_ARGS="${CMD_ARGS} -root-ca-cert=${ROOT_CA_CERT}"
fi

echo "CMD_ARGS: $CMD_ARGS"

./router -listen :$LISTEN_PORT $CMD_ARGS &
PID=$!

trap 'finish $PID' TERM INT

wait $PID
