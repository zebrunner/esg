FROM golang:1.18-alpine

RUN apk add -U ca-certificates tzdata mailcap curl git && rm -Rf /var/cache/apk/*

WORKDIR /esg

# Download dependencies
COPY ./go.mod .
COPY ./go.sum .
RUN go mod download

# Build esg
COPY . /esg

RUN GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build ./cmd/scaler


FROM alpine:latest

ENV AWS_ASG_NAME=
ENV RESERVE_INSTANCES_PERCENT=
ENV RESERVE_MAX_CAPACITY=
ENV INSTANCE_COOLDOWN_TIMEOUT=

ENV AWS_REGION=
ENV AWS_RETRY=

ENV AWS_CLUSTER=

ENV AWS_ACESS_KEY_ID=
ENV AWS_SECRET_ACCESS_KEY=

ENV AWS_ELASTIC_CACHE=
ENV LOG_LEVEL=

ENV IMDSV2_ENABLED=

ENV DATABASE=

ENV MAX_MEMORY=

ENV MAX_CPU=

#time.Duration format: 1m0s
ENV MAX_IDLE_TIMEOUT=
ENV IDLE_TIMEOUT=
ENV MAX_TIMEOUT=

ENV ZEBRUNNER_HOST=
ENV ZEBRUNNER_INTEGRATION_USER=
ENV ZEBRUNNER_INTEGRATION_PASSWORD=

ENV EXCLUDE_BROWSERS=

COPY --from=0 /esg/scaler /scaler

COPY ./build/entrypoint.scaler /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
