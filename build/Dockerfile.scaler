FROM golang:1.18-alpine

RUN apk add -U ca-certificates tzdata mailcap curl git && rm -Rf /var/cache/apk/*

WORKDIR /esg

# Download dependencies
COPY ./go.mod .
COPY ./go.sum .
RUN go mod download

# Build esg
COPY . /esg

RUN GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build ./cmd/management


FROM alpine:latest

ENV BROWSERS_FILE=/browsers.txt

#Scaler specific
ENV AWS_ASG_NAME=
ENV RESERVE_INSTANCES_PERCENT=
ENV INSTANCE_COOLDOWN_TIMEOUT=

#Common for router and scaler
ENV AWS_REGION=
ENV AWS_RETRY=

ENV AWS_CLUSTER=
ENV USE_PUBLIC_IP=

ENV AWS_ACESS_KEY_ID=
ENV AWS_SECRET_ACCESS_KEY=

ENV AWS_ELASTIC_CACHE=
ENV LOG_LEVEL=
ENV S3_BUCKET=

ENV DATABASE=

ENV MIN_MEMORY=
ENV MAX_MEMORY=

ENV MIN_CPU=
ENV MAX_CPU=

#time.Duration format: 1m0s
ENV IDLE_TIMEOUT=
ENV SESSION_STARTUP_TIMEOUT=
ENV SESSION_DELETE_TIMEOUT=
ENV SERVICE_STARTUP_TIMEOUT=
ENV MAX_TIMEOUT=


ENV ZEBRUNNER_HOST=
ENV ZEBRUNNER_INTEGRATION_USER=
ENV ZEBRUNNER_INTEGRATION_PASSWORD=


COPY --from=0 /esg/management /management
COPY --from=0 /esg/browsers.txt /browsers.txt

COPY ./build/entrypoint.scaler /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
