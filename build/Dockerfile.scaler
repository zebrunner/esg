FROM golang:1.25-alpine

WORKDIR /esg

# Download dependencies
COPY ./go.mod .
COPY ./go.sum .
RUN go mod download

# Build esg
COPY . /esg

RUN GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build ./cmd/scaler


FROM alpine:latest

ENV LOG_LEVEL=

ENV RESERVE_INSTANCES_PERCENT=
ENV RESERVE_MAX_CAPACITY=
ENV LOST_TASK_COOLDOWN_TIMEOUT=
ENV INSTANCE_COOLDOWN_TIMEOUT=

ENV AWS_REGION=
ENV AWS_RETRY=
ENV AWS_CLUSTER=
ENV AWS_ACCESS_KEY_ID=
ENV AWS_SECRET_ACCESS_KEY=

ENV ELASTIC_CACHE=
ENV CACHE_REMOTE=
ENV DATABASE=

#time.Duration format: 1m0s
ENV MAX_IDLE_TIMEOUT=
ENV IDLE_TIMEOUT=
ENV MAX_TIMEOUT=
ENV RECORDING_SHUTDOWN_GRACE_PERIOD=

ENV ZEBRUNNER_HOST=
ENV ZEBRUNNER_INTEGRATION_USER=
ENV ZEBRUNNER_INTEGRATION_PASSWORD=

ENV OLD_ABORT_API=

COPY ./build/.env version
COPY ./build/entrypoint.scaler /entrypoint.sh

COPY --from=0 /esg/scaler /scaler

ENTRYPOINT ["/entrypoint.sh"]
