# Timeoouts limitations in time.Duration format, for example: 1m0s
SESSION_DELETE_TIMEOUT=
SERVICE_STARTUP_TIMEOUT=

# AWS settings
AWS_LINUX_CAPACITY_PROVIDER=
AWS_LINUX_GENERIC_CAPACITY_PROVIDER=
AWS_WIN_CAPACITY_PROVIDER=
AWS_TARGET_GROUP=

# AWSVPC settings
# SUBNETS AND SECURITY_GROUPS formating example: SECURITY_GROUPS=sg-1;sg-2 and SUBNETS=subnet-1;subnet-2;subnet-3
SECURITY_GROUPS=
SUBNETS=

# For internal usage only
PRODUCTION_ENV=
