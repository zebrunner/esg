# Router settings
API_ACCESS_KEY=secure_password
USE_PUBLIC_IP=false
E3S_URL=

# Timeoouts limitations in time.Duration format, for example: 1m0s
SESSION_DELETE_TIMEOUT=
SERVICE_STARTUP_TIMEOUT=

# AWS settings
AWS_LINUX_CAPACITY_PROVIDER=
#Optional capacity provider for generic linux instances
AWS_LINUX_GENERIC_CAPACITY_PROVIDER=
AWS_WIN_CAPACITY_PROVIDER=
AWS_TARGET_GROUP=

# For internal usage only
PRODUCTION_ENV=

# Base64-encoded PEM CA certificate injected into browser containers (optional, overridden per-session via capabilities.zebrunner\:options.rootCACert capability)
ROOT_CA_CERT=
