# Timeoouts limitations in time.Duration format, for example: 1m0s
IDLE_TIMEOUT=
MAX_TIMEOUT=

# AWS settings
AWS_REGION=us-east-1
AWS_RETRY=10
AWS_CLUSTER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_TASK_ROLE=
AWS_LOGS_GROUP=

# Disable IMDS calls (set to true when hop limit = 1)
AWS_DISABLE_IMDS=true
# Instance ID for ELB target registration (required when AWS_DISABLE_IMDS=true and using target group)
AWS_TARGET_ID=

# S3 settings
S3_BUCKET=
S3_REGION=
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=

# Log level: trace, debug, info, error etc
LOG_LEVEL=info
AWS_LOGS_GROUP=

# Zebrunner Testing Platform integration
ZEBRUNNER_HOST=
ZEBRUNNER_INTEGRATION_USER=
ZEBRUNNER_INTEGRATION_PASSWORD=
ZEBRUNNER_ENV=

# For internal usage only
SINGLE_TENANT=
OLD_ABORT_API=
