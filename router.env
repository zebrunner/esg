# Router settings
API_ACCESS_KEY=secure_password
USE_PUBLIC_IP=false

# Timeoouts limitations in time.Duration format, for example: 1m0s
SESSION_DELETE_TIMEOUT=
SERVICE_STARTUP_TIMEOUT=

# AWS settings
AWS_LINUX_CAPACITY_PROVIDER=
AWS_WIN_CAPACITY_PROVIDER=
AWS_TARGET_GROUP=

# S3 settings
S3_BUCKET=
S3_REGION=us-east-1
S3_AWS_ACESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=
